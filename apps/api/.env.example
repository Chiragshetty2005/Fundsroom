NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mini_erp
DB_USER=mini_erp_app
DB_PASSWORD=replace-with-your-local-postgres-password
DB_SCHEMA=public

JWT_SECRET=replace-with-a-long-random-development-secret
SEED_USER_PASSWORD=replace-with-a-strong-local-test-password

# AWS S3 Configuration (Product Image Uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
