# ==============================================================================
# Mini ERP + CRM Environment Configuration Template
# ==============================================================================

# Node & Runtime
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mini_erp
DB_USER=mini_erp_app
DB_PASSWORD=postgres123
DB_SCHEMA=public

# Database URL (Used by Prisma for migrations and CLI commands)
DATABASE_URL="postgresql://mini_erp_app:postgres123@localhost:5432/mini_erp?schema=public"

# Authentication (JWT)
# Must be at least 24 characters long
JWT_SECRET=my-super-secret-jwt-key-for-dev-1234
JWT_EXPIRES_IN=8h

# Seed User Password (Used by prisma/seed.ts for demo accounts)
# Must be at least 12 characters
SEED_USER_PASSWORD=localTestPass123

# Frontend Environment Variables
VITE_API_URL=http://localhost:3000
